}

% Rounded alternative-solution marker.  The star is optional, allowing
% \MMAlternative[]{...} when a particular article does not use a rating mark.
\NewDocumentCommand{\MMAlternative}{O{★} m}{%
  \par\addvspace{.7\baselineskip}
  \noindent
  \MMSolutionLabel{別解}%
  \ifstrempty{#1}{}{\hspace{.28em}{\normalfont #1}}%
  \ifstrempty{#2}{}{\hspace{.65em}{\normalfont #2}}%
  \par\nobreak\addvspace{.18\baselineskip}%
}

% Confirmation symbols use one deterministic drawing system.  TikZ's generic
% pattern fill is anchored to page coordinates, so otherwise identical marks
% can begin their hatching at different phases.  These explicit local strokes
% keep every occurrence identical and give filled/hatched variants one outline.
\def\smag@confirmation@squarepath{%
  (0,0) rectangle (.82,.82)%
}
\def\smag@confirmation@arrowpath{%
  (0,.28) -- (.78,.28) -- (.78,0)
  -- (1.25,.41)
  -- (.78,.82) -- (.78,.54) -- (0,.54) -- cycle%
}

\tikzset{
  smag confirmation outline/.style={
    draw=SMink,
    line width=.38pt,
    line cap=butt,
    line join=miter
  },
  smag confirmation hatch/.style={
    draw=SMink,
    line width=.28pt,
    line cap=butt
  }
}

\newcommand{\smag@confirmation@hatchlines}{%
  \foreach \smag@hatchoffset in
    {-1.40,-1.12,-.84,-.56,-.28,0,.28,.56,.84}{%
      \draw[smag confirmation hatch]
        (\smag@hatchoffset,-.42) -- ++(1.68,1.68);%
  }%
}

\newcommand{\smag@confirmation@symbol}[3]{%
  \tikz[baseline=.17em,x=1em,y=1em]{%
    \path[use as bounding box] (0,0) rectangle (#2,.82);%
    \ifstrequal{#1}{filled}{%
      \path[fill=SMink] #3;%
    }{%
      \begin{scope}
        \clip #3;%
        \path[fill=white] #3;%
        \smag@confirmation@hatchlines
      \end{scope}
    }%
    \path[smag confirmation outline] #3;%
  }%
}

\NewDocumentCommand{\MMConfirmationStripedMark}{}{%
  \smag@confirmation@symbol{hatched}{.82}{\smag@confirmation@squarepath}%
}

\NewDocumentCommand{\MMConfirmationFilledMark}{}{%
  \smag@confirmation@symbol{filled}{.82}{\smag@confirmation@squarepath}%
}

% Arrow-plus-note marks.  They use the same audience distinction as the
% square comment marks: hatched for every reader, solid for motivated readers.
\NewDocumentCommand{\MMConfirmationStripedNoteMark}{}{%
  \smag@confirmation@symbol{hatched}{1.25}{\smag@confirmation@arrowpath}%
  \hspace{.12em}{\normalfont\rmfamily\mcfamily\mdseries 注}%
}

\NewDocumentCommand{\MMConfirmationFilledNoteMark}{}{%
  \smag@confirmation@symbol{filled}{1.25}{\smag@confirmation@arrowpath}%
  \hspace{.12em}{\normalfont\rmfamily\mcfamily\mdseries 注}%
}

\newcommand{\smag@confirmationcomment@begin}[2]{%
  \par\addvspace{.55\baselineskip}
  \noindent #1%
  \ifstrempty{#2}{}{\hspace{.38em}{\bfseries #2}}%
  \hspace{.65em}\ignorespaces
}

\newcommand{\smag@confirmationcomment@end}{%
  \par\addvspace{.28\baselineskip}%
}

% Leave the optional number empty for an isolated comment.  Supply 1, 2, ...
% only while a related local sequence continues; never use a document-wide
% running comment number.
% Hatched square: a comment intended for every reader.
\NewDocumentEnvironment{mmconfirmationgeneralcomment}{O{}}{%
  \smag@confirmationcomment@begin{\MMConfirmationStripedMark}{#1}%
}{%
  \smag@confirmationcomment@end
}

% Solid square: an optional or advanced comment for motivated readers.
\NewDocumentEnvironment{mmconfirmationadvancedcomment}{O{}}{%
  \smag@confirmationcomment@begin{\MMConfirmationFilledMark}{#1}%
}{%
  \smag@confirmationcomment@end
}

% Backward-compatible generic name.  It always means the general,
% all-readers form; new source should prefer the explicit environment name.
\NewDocumentEnvironment{mmconfirmationcomment}{O{}}{%
  \begin{mmconfirmationgeneralcomment}[#1]%
}{%
  \end{mmconfirmationgeneralcomment}%
}

% Short square comments.  Square marks have no other semantic use.
\NewDocumentCommand{\MMConfirmationGeneralComment}{O{} +m}{%
  \begin{mmconfirmationgeneralcomment}[#1]#2\end{mmconfirmationgeneralcomment}%
}

\NewDocumentCommand{\MMConfirmationAdvancedComment}{O{} +m}{%
  \begin{mmconfirmationadvancedcomment}[#1]#2\end{mmconfirmationadvancedcomment}%
}

% Arrow-plus-note annotations.  The fill again indicates the audience.
\NewDocumentEnvironment{mmconfirmationgeneralnote}{O{}}{%
  \smag@confirmationcomment@begin{\MMConfirmationStripedNoteMark}{#1}%
}{%
  \smag@confirmationcomment@end
}

\NewDocumentEnvironment{mmconfirmationadvancednote}{O{}}{%
  \smag@confirmationcomment@begin{\MMConfirmationFilledNoteMark}{#1}%
}{%
  \smag@confirmationcomment@end
}

\NewDocumentEnvironment{mmconfirmationnote}{O{}}{%
  \begin{mmconfirmationgeneralnote}[#1]%
}{%
  \end{mmconfirmationgeneralnote}%
}

\NewDocumentCommand{\MMConfirmationGeneralNote}{O{} +m}{%
  \begin{mmconfirmationgeneralnote}[#1]#2\end{mmconfirmationgeneralnote}%
}

\NewDocumentCommand{\MMConfirmationAdvancedNote}{O{} +m}{%
  \begin{mmconfirmationadvancednote}[#1]#2\end{mmconfirmationadvancednote}%
}

% Backward-compatible generic short name: a general note for every reader.
\NewDocumentCommand{\MMConfirmationNote}{O{} +m}{%
  \MMConfirmationGeneralNote[#1]{#2}%
}

\NewDocumentCommand{\MMConfirmationProofLabel}{O{証明}}{%
  {\sffamily\gtfamily\bfseries [#1]}\nobreak\hspace{.65em}%
}

\NewDocumentEnvironment{mmconfirmationproof}{O{証明}}{%
  \par\addvspace{.48\baselineskip}
  \noindent\MMConfirmationProofLabel[#1]\ignorespaces
}{%
  \par\addvspace{.28\baselineskip}%
}

\NewDocumentCommand{\MMConfirmationRunInHeading}{m}{%
  {\sffamily\gtfamily\bfseries #1：}\nobreak\hspace{.5em}%
}

% Lecture-style note used by the pre-existing article format.
\NewDocumentCommand{\MMNote}{m}{%
  \par\smallskip
  \begingroup
    \fontsize{\smag@bodyfontsize}{\smag@bodyleading}\selectfont
    \normalfont\rmfamily\mcfamily\mdseries
    \noindent
    \textcolor{SMrule}{\raisebox{.05ex}{$\blacktriangleright$}}%
