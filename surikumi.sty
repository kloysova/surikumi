\newcommand{\smag@coveranimal}{%
  \ifstrempty{\smag@coveranimalimage}{}{%
    \IfFileExists{\smag@coveranimalimage}{%
      \begin{scope}[blend mode=multiply]
        \node[
          anchor=south west,
          inner sep=0pt,
