  {\small\sffamily\gtfamily\bfseries ◎問題の難易と目標時間}%
  \hspace{.45em}{\scriptsize #1}\hfill\rule{8mm}{.7pt}\par
  \vspace{1mm}{\normalfont\mcfamily #2}\par\vspace{1.5mm}
}

