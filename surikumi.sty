\RequirePackage{amsmath}

% Mathematics is set in the OpenType math font that matches the Latin text
% face.  unicode-math has to be loaded after amsmath and before the
% summation is captured below, because it installs a \sum of its own.
%
% amssymb and bm are deliberately kept out of that combination.  Both
% register legacy symbol fonts, and with either of them in place the
% \mathchoice further down stops honouring \limits: the range of an inline
% sum jumps back beside the sigma.  unicode-math already covers every
% symbol this package and its style guides use, so only the three names it
% leaves undefined are restored below.
\newif\ifsmag@unicodemath
\ifsmag@mathfont
  \IfFileExists{unicode-math.sty}{%
    \IfFontExistsTF{\smag@mathfontname}{%
      \RequirePackage{unicode-math}%
      % bold-style=ISO keeps vectors bold italic, which is what \bm used to
      % produce and what the notation style guide follows elsewhere when it
      % takes its upright d, e and i from ISO 80000-2.  The default would
      % set \bm{v} upright and only \bm{\omega} slanted.
      \setmathfont{\smag@mathfontname}[bold-style=ISO]%
      \smag@unicodemathtrue
    }{%
      \PackageWarning{surikumi}%
        {Math font `\smag@mathfontname' not found;\MessageBreak
         formulas stay in the default math font}%
    }%
  }{%
    \PackageWarning{surikumi}%
      {unicode-math not found;\MessageBreak
       formulas stay in the default math font}%
  }%
\fi
\ifsmag@unicodemath
  \providecommand{\square}{\mdlgwhtsquare}
  \providecommand{\blacksquare}{\mdlgblksquare}
  % The notation style guide asks for \bm.  amsmath brings in amsbsy, whose
  % \bm builds its bold by overprinting and produces nothing legible in an
  % OpenType math font, so \bm becomes the name for \symbf here.
  \let\bm\symbf
  % Loading either package afterwards silently breaks the fixed-size sum.
  \AtBeginDocument{%
    \@ifpackageloaded{amssymb}{%
      \PackageWarning{surikumi}%
        {amssymb is loaded on top of unicode-math;\MessageBreak
         the inline sum will place its range beside the sigma.\MessageBreak
         Drop amssymb, or pass mathfont=false to surikumi}%
    }{}%
    \@ifpackageloaded{bm}{%
      \PackageWarning{surikumi}%
        {bm is loaded on top of unicode-math;\MessageBreak
         the inline sum will place its range beside the sigma.\MessageBreak
         Use \string\symbf, for which \string\bm\space is an alias here}%
    }{}%
  }%
\else
  \RequirePackage{amssymb}
\fi

% In this magazine style, display and inline summations use the same
% text-style glyph.  Their ranges are always stacked above and below.
\newcommand{\smag@fixedsum}{%
  \mathop{%
    \mathchoice
      {\textstyle\smag@originalsum}%
      {\textstyle\smag@originalsum}%
      {\scriptstyle\smag@originalsum}%
      {\scriptscriptstyle\smag@originalsum}%
  }\limits
}
% unicode-math installs its own \sum while it finishes setting up the math
% font, which happens after this package is read and would silently undo
% the definition below.  Installing it again at the beginning of the
% document is what makes it survive.  The guard keeps the capture from
% pointing \smag@originalsum at \smag@fixedsum itself, which would loop.
\newcommand{\smag@installfixedsum}{%
  \ifx\sum\smag@fixedsum\else
    \let\smag@originalsum\sum
    \let\sum\smag@fixedsum
  \fi
}
\smag@installfixedsum
\ifsmag@unicodemath
  \AtBeginDocument{\smag@installfixedsum}%
\fi

