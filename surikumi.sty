}{%
  \smag@confirmationcomment@end
}

\NewDocumentEnvironment{mmconfirmationadvancednote}{O{}}{%
  \smag@confirmationcomment@begin{\MMConfirmationFilledNoteMark}{#1}%
}{%
  \smag@confirmationcomment@end
}

\NewDocumentEnvironment{mmconfirmationnote}{O{}}{%
  \begin{mmconfirmationgeneralnote}[#1]%
}{%
  \end{mmconfirmationgeneralnote}%
}

\NewDocumentCommand{\MMConfirmationGeneralNote}{O{} +m}{%
