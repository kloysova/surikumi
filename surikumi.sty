    \pgfpathlineto{\pgfpoint{2mm}{12mm}}%
    \pgfpathmoveto{\pgfpoint{5mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{11mm}{1mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{5mm}}%
    \pgfpathmoveto{\pgfpoint{5mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{9mm}}%
