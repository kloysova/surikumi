% cuted balances the material that precedes a full-width block into two
% columns whose common height it searches for in \cuted@@tempdim@b, but it
% then packs those columns into boxes of the height it had guessed before
% the search, \ht@viper.  On a dense page the two columns usually cannot be
% balanced -- rigid blocks leave no glue to stretch -- so the search ends
% above the guess, the packed boxes overflow downwards, and the full-width
% block is printed on top of the last line of a column.  Growing \ht@viper
% to the height actually used, and asking for the matching extra room on
% the page, is what keeps the two apart.
\ifsmag@strip
  \newcommand{\smag@growviper}{%
    \ifdim\cuted@@tempdim@b>\ht@viper
      \advance\@reqcolroom\dimexpr\cuted@@tempdim@b-\ht@viper\relax
      \ht@viper\cuted@@tempdim@b
    \fi
  }%
  \patchcmd{\@addviper}
    {\setbox\cuted@@tempbox@var\vbox}
    {\smag@growviper\setbox\cuted@@tempbox@var\vbox}
    {}%
    {\PackageWarning{surikumi}%
      {Cannot align the columns above a full-width block; \string\stripsep
       alone has to keep them apart}}%
\fi

% A coordinated vertical-rhythm system.  Compact mode reduces ordinary
% leading and the whitespace around mathematics together, while lineskip is
% retained as a safety valve for unusually tall inline material.
\newcommand{\smag@applyverticalrhythm}{%
  \ifdefstring{\smag@density}{standard}{%
    \setlength{\lineskip}{1pt}%
    \setlength{\lineskiplimit}{0pt}%
    \setlength{\abovedisplayskip}{.55\baselineskip}%
    \setlength{\belowdisplayskip}{.55\baselineskip}%
    \setlength{\abovedisplayshortskip}{.25\baselineskip}%
    \setlength{\belowdisplayshortskip}{.35\baselineskip}%
    \setlength{\jot}{3pt}%
  }{%
    \ifdefstring{\smag@density}{compact}{}{%
      % `airy' starts from the compact values and opens them afterwards in
      % \smag@applyairyrhythm, so it is a known name here.
      \ifdefstring{\smag@density}{airy}{}{%
        \PackageWarning{surikumi}%
          {Unknown density '\smag@density'; using compact}%
      }%
    }%
    \setlength{\lineskip}{.7pt}%
    \setlength{\lineskiplimit}{.2pt}%
    \setlength{\abovedisplayskip}{.42\baselineskip}%
    \setlength{\belowdisplayskip}{.42\baselineskip}%
    \setlength{\abovedisplayshortskip}{.18\baselineskip}%
    \setlength{\belowdisplayshortskip}{.26\baselineskip}%
    \setlength{\jot}{.16\baselineskip}%
  }%
}

% A third vertical rhythm for long reading sessions.  It is applied after
% \smag@applyverticalrhythm, so `compact' and `standard' keep exactly the
% values above.  Everything an article needs in order to breathe is moved
% together: basic leading, the space around displays, and the gap between
% the rows of an aligned display.
\newcommand{\smag@applyairyrhythm}{%
  \ifdefstring{\smag@density}{airy}{%
    \setlength{\lineskip}{1.3pt}%
    \setlength{\lineskiplimit}{.55pt}%
    \setlength{\abovedisplayskip}{.7\baselineskip}%
    \setlength{\belowdisplayskip}{.7\baselineskip}%
    \setlength{\abovedisplayshortskip}{.33\baselineskip}%
    \setlength{\belowdisplayshortskip}{.45\baselineskip}%
    \setlength{\jot}{.22\baselineskip}%
  }{}%
}

% The basic leading belongs to the same decision, so `airy' also opens it.
% A document that named its own bodyleading keeps that value untouched,
% even when it happens to have named the default.
\ifdefstring{\smag@density}{airy}{%
  \ifsmag@bodyleadinggiven\else\def\smag@bodyleading{12.2pt}\fi
}{}

