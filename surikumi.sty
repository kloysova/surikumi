% One large numbered question inside mmmockpaper.  The optional argument is a
% parenthetical classification such as 共通, 文系, or 理系.
\NewDocumentEnvironment{mmmockquestion}{m O{}}{%
  \begin{list}{}{%
    \setlength{\leftmargin}{3.25em}%
    \setlength{\labelwidth}{2.45em}%
    \setlength{\labelsep}{.55em}%
    \setlength{\topsep}{.45\baselineskip}%
    \setlength{\partopsep}{0pt}%
    \setlength{\parsep}{.15\baselineskip}%
    \setlength{\itemsep}{0pt}%
  }%
  \item[\MMMockNumber{#1}]%
  \ifstrempty{#2}{}{{\normalfont\mcfamily（#2）}\hspace{.85em}}%
  \ignorespaces
}{%
  \end{list}%
}

