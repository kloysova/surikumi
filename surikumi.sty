}

% Solid-rule example box. The optional argument overrides the automatic
% number, e.g. \begin{mmexample}[3.1]{次の定積分を計算せよ．}
\newcounter{mmexample}
\NewDocumentEnvironment{mmexample}{O{} m}{%
  \refstepcounter{mmexample}%
  \def\smag@example@number{#1}%
  \ifstrempty{#1}{\edef\smag@example@number{\arabic{mmexample}}}{}%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    colback=white,
    colframe=SMrule,
    boxrule=.55pt,
    sharp corners,
    left=2.5mm,
    right=2.5mm,
    top=2.2mm,
    bottom=2.3mm,
    before skip=.8\baselineskip,
    after skip=.8\baselineskip
  ]%
  \noindent\MMBlackLabel{例題}\hspace{.35em}%
  \MMExerciseNumber{\smag@example@number}\hspace{.8em}#2\par\smallskip
}{%
  \end{tcolorbox}%
}

% Boxed lecture problem.  Kept separate from the numbered drill list so that
