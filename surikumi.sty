% Offset rectangular tiles.  Only the two cells of one colour are drawn:
% in a pattern declared `for only' the ink is a single colour supplied from
% outside, so filling all four cells --- which is what a two-tone reading
% of the tile would ask for --- covers the whole tile and prints a solid
% band.  Leaving the other two cells open lets the banner ground show
% through, which is what makes the chequerboard visible, and it keeps
% `pattern-tone' and `pattern-accent' working as they do for the rest of
% the geometric family.
\pgfdeclarepatternformonly{SMchecker}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfpathrectangle{\pgfpoint{0mm}{0mm}}{\pgfpoint{6mm}{4mm}}%
    \pgfusepath{fill}%
    \pgfpathrectangle{\pgfpoint{6mm}{4mm}}{\pgfpoint{6mm}{4mm}}%
    \pgfusepath{fill}%
  }

% Angular parquet linework, based on interlocking wooden strips.
\pgfdeclarepatternformonly{SMparquet}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{16mm}{12mm}}
  {\pgfpoint{16mm}{12mm}}
  {%
    \pgfsetlinewidth{.42pt}%
    \pgfsetstrokecolor{SMrule}%
    \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{8mm}{6mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{0mm}}%
    \pgfpathmoveto{\pgfpoint{0mm}{12mm}}%
    \pgfpathlineto{\pgfpoint{8mm}{6mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{12mm}}%
    \pgfpathmoveto{\pgfpoint{4mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{8mm}{3mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{0mm}}%
    \pgfpathmoveto{\pgfpoint{4mm}{12mm}}%
    \pgfpathlineto{\pgfpoint{8mm}{9mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{12mm}}%
    \pgfpathmoveto{\pgfpoint{0mm}{3mm}}%
    \pgfpathlineto{\pgfpoint{4mm}{6mm}}%
    \pgfpathlineto{\pgfpoint{0mm}{9mm}}%
    \pgfpathmoveto{\pgfpoint{16mm}{3mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{6mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{9mm}}%
    \pgfusepath{stroke}%
  }

% Fine triangular facets: a light origami-like network.
\pgfdeclarepatternformonly{SMorigami}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{16mm}{12mm}}
  {\pgfpoint{16mm}{12mm}}
  {%
    \pgfsetlinewidth{.32pt}%
    \pgfsetstrokecolor{SMrule}%
    \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{5mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{2mm}{12mm}}%
    \pgfpathmoveto{\pgfpoint{5mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{11mm}{1mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{5mm}}%
    \pgfpathmoveto{\pgfpoint{5mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{9mm}}%
    \pgfpathlineto{\pgfpoint{2mm}{12mm}}%
    \pgfpathmoveto{\pgfpoint{9mm}{9mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{5mm}}%
    \pgfpathlineto{\pgfpoint{14mm}{12mm}}%
    \pgfpathmoveto{\pgfpoint{11mm}{1mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{9mm}}%
    \pgfusepath{stroke}%
  }

% Alternating broad ribbons with a clear diagonal rhythm.
\pgfdeclarepatternformonly{SMribbons}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{16mm}{12mm}}
  {\pgfpoint{16mm}{12mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{4mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{9mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{12mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{12mm}}%
    \pgfpathlineto{\pgfpoint{0mm}{3mm}}%
    \pgfpathclose\pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathmoveto{\pgfpoint{12mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{3mm}}%
    \pgfpathlineto{\pgfpoint{4mm}{12mm}}%
    \pgfpathlineto{\pgfpoint{0mm}{12mm}}%
    \pgfpathlineto{\pgfpoint{0mm}{9mm}}%
    \pgfpathclose\pgfusepath{fill}%
  }

% ---------------------------------------------------------------------------
% Traditional Japanese geometric motifs (wagara).  These are public-domain
% designs, redrawn here from scratch with plain pgf paths.  Unlike the twelve
% patterns above they are declared as inherently coloured patterns, so the
% grey levels written into the tile (SMrule, SMpale, SMpatternA, SMpatternB)
% survive into the output instead of collapsing to a single ink.  That keeps
% the texture pale enough to sit under a 25pt title without a heavy white
% wash.  Every tile repeats exactly at its edges; shapes that cross an edge
% are drawn again one period away so the PDF tile clip cannot open a seam.
% ---------------------------------------------------------------------------

% Asanoha (hemp leaf): six-pointed stars on a triangular net.  Airy line work
% for feature articles that want a classical, slightly formal opening.
\pgfdeclarepatterninherentlycolored{SMasanoha}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{16mm}{12mm}}
  {\pgfpoint{16mm}{12mm}}
  {%
    \pgfsetlinewidth{.3pt}%
    \pgfsetstrokecolor{SMrule}%
    % One rhombic cell carries two lattice triangles; the list covers the tile
    % plus one ring of neighbours so the clipped edges stay continuous.
    \foreach \px/\py in {%
      -12/-6,-4/-6,4/-6,12/-6,%
      -8/0,0/0,8/0,16/0,%
      -4/6,4/6,12/6,20/6}{%
      \begin{pgfscope}%
        \pgftransformshift{\pgfpoint{\px mm}{\py mm}}%
        \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
        \pgfpathlineto{\pgfpoint{8mm}{0mm}}%
        \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
        \pgfpathlineto{\pgfpoint{4mm}{6mm}}%
        \pgfpathmoveto{\pgfpoint{8mm}{0mm}}%
        \pgfpathlineto{\pgfpoint{4mm}{6mm}}%
        \pgfpathmoveto{\pgfpoint{4mm}{2mm}}%
        \pgfpathlineto{\pgfpoint{0mm}{0mm}}%
        \pgfpathmoveto{\pgfpoint{4mm}{2mm}}%
        \pgfpathlineto{\pgfpoint{8mm}{0mm}}%
        \pgfpathmoveto{\pgfpoint{4mm}{2mm}}%
        \pgfpathlineto{\pgfpoint{4mm}{6mm}}%
        \pgfpathmoveto{\pgfpoint{8mm}{4mm}}%
        \pgfpathlineto{\pgfpoint{8mm}{0mm}}%
        \pgfpathmoveto{\pgfpoint{8mm}{4mm}}%
        \pgfpathlineto{\pgfpoint{4mm}{6mm}}%
        \pgfpathmoveto{\pgfpoint{8mm}{4mm}}%
        \pgfpathlineto{\pgfpoint{12mm}{6mm}}%
        \pgfusepath{stroke}%
      \end{pgfscope}%
    }%
  }

% Seigaiha (blue ocean waves): rows of concentric fans, each row overlapping
% the one below.  A calm flowing ground, good for essays and for openings
% about continuity or limits.  The tile is 16mm by 8mm because the circles
% sit on a square lattice turned by 45 degrees whose spacing is 4mm times
% root two; that lattice covers the plane exactly, with no gap and no seam.
\pgfdeclarepatterninherentlycolored{SMseigaiha}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{16mm}{8mm}}
  {\pgfpoint{16mm}{8mm}}
  {%
    \pgfsetlinewidth{.32pt}%
    % Painter's order, lowest row first: every fan first lays down its own
    % pale ground and then its rings, so a fan hides the one behind it just
    % as it does in the woven original.  Circles centred above the tile are
    % irrelevant here because they only touch its top edge.
    \foreach \cx/\cy in {0/0,8/0,16/0,4/4,12/4,0/8,8/8,16/8}{%
      \begin{pgfscope}%
        \pgftransformshift{\pgfpoint{\cx mm}{\cy mm}}%
        \pgfsetfillcolor{SMpale}%
        \pgfpathcircle{\pgfpointorigin}{4mm}%
        \pgfusepath{fill}%
        \pgfsetstrokecolor{SMrule}%
        \pgfpathcircle{\pgfpointorigin}{4mm}%
        \pgfpathcircle{\pgfpointorigin}{3mm}%
        \pgfpathcircle{\pgfpointorigin}{2mm}%
        \pgfpathcircle{\pgfpointorigin}{1mm}%
        \pgfusepath{stroke}%
      \end{pgfscope}%
    }%
  }

% Shippou (seven treasures): interlocking circles that leave four-petal
% openings.  The lightest of the wagara set; safe under long titles.
\pgfdeclarepatterninherentlycolored{SMshippou}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{.3pt}%
    \pgfsetstrokecolor{SMrule}%
    % Semi-axes are half the lattice diagonal, so every circle runs through
    % the centre of its cell and the petals close exactly.
    \foreach \cx in {0,6,12}{%
      \foreach \cy in {0,4,8}{%
        \pgfpathellipse{\pgfpoint{\cx mm}{\cy mm}}%
          {\pgfpoint{4.243mm}{0mm}}{\pgfpoint{0mm}{2.828mm}}%
      }%
    }%
    \pgfusepath{stroke}%
  }

% Kikkou (tortoise shell): a plain hexagonal net.  Reads as an orderly grid,
% a good ground for reference and formula articles.
\pgfdeclarepatterninherentlycolored{SMkikkou}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{.34pt}%
    \pgfsetstrokecolor{SMrule}%
    % Flat-top cells on the lattice generated by (12mm,0) and (6mm,4mm); the
    % cell is very slightly taller than a regular hexagon so that the house
    % 12mm by 8mm tile can be kept.
    \foreach \cx/\cy in {6/-4,0/0,12/0,6/4,0/8,12/8,6/12}{%
      \begin{pgfscope}%
        \pgftransformshift{\pgfpoint{\cx mm}{\cy mm}}%
        \pgfpathmoveto{\pgfpoint{4mm}{0mm}}%
        \pgfpathlineto{\pgfpoint{2mm}{4mm}}%
        \pgfpathlineto{\pgfpoint{-2mm}{4mm}}%
        \pgfpathlineto{\pgfpoint{-4mm}{0mm}}%
        \pgfpathlineto{\pgfpoint{-2mm}{-4mm}}%
        \pgfpathlineto{\pgfpoint{2mm}{-4mm}}%
        \pgfpathclose
        \pgfusepath{stroke}%
      \end{pgfscope}%
    }%
  }

% Sayagata: the linked key fret of figured silk.  Firm and architectural,
% with long shallow diagonals; suits algebra, proof and analysis articles.
% The tile is square and larger than the house sizes because the fret only
% closes on a square lattice tilted by arctan(2/3): with an arm of three
% units and a hook of two, the smallest upright period is 26 units each way.
% The motif itself is still about 5.5mm across, so it repeats often enough.
\pgfdeclarepatterninherentlycolored{SMsayagata}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{24mm}{24mm}}
  {\pgfpoint{24mm}{24mm}}
  {%
    \pgfsetlinewidth{.34pt}%
    \pgfsetstrokecolor{SMrule}%
    % Unit u = 24mm/26.  Hook tips meet exactly at the lattice vectors
    % (6u,4u) and (4u,-6u), which is what links the fret into one line.
    \foreach \a in {-5,...,5}{%
      \foreach \b in {-5,...,5}{%
        \begin{pgfscope}%
          \pgftransformshift{\pgfpointadd
            {\pgfpointscale{\a}{\pgfpoint{5.5385mm}{3.6923mm}}}
            {\pgfpointscale{\b}{\pgfpoint{3.6923mm}{-5.5385mm}}}}%
          \pgfpathmoveto{\pgfpoint{-1.8462mm}{2.7692mm}}%
          \pgfpathlineto{\pgfpoint{0mm}{2.7692mm}}%
          \pgfpathlineto{\pgfpoint{0mm}{-2.7692mm}}%
          \pgfpathlineto{\pgfpoint{1.8462mm}{-2.7692mm}}%
          \pgfpathmoveto{\pgfpoint{-2.7692mm}{-1.8462mm}}%
          \pgfpathlineto{\pgfpoint{-2.7692mm}{0mm}}%
          \pgfpathlineto{\pgfpoint{2.7692mm}{0mm}}%
          \pgfpathlineto{\pgfpoint{2.7692mm}{1.8462mm}}%
          \pgfusepath{stroke}%
        \end{pgfscope}%
      }%
    }%
  }

% Kagome (basket eye): three families of straight lines leaving triangles and
% hexagons.  Very open; the quietest ground for a long title.
\pgfdeclarepatterninherentlycolored{SMkagome}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{.34pt}%
    \pgfsetstrokecolor{SMrule}%
    % The horizontal family is offset by half a step so that no three lines
    % are concurrent; that offset is exactly what opens the hexagons.
    \pgfpathmoveto{\pgfpoint{0mm}{2mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{2mm}}%
    \pgfpathmoveto{\pgfpoint{0mm}{6mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{6mm}}%
    \foreach \ax/\bx in {-6/0,0/6,6/12,12/18}{%
      \pgfpathmoveto{\pgfpoint{\ax mm}{0mm}}%
      \pgfpathlineto{\pgfpoint{\bx mm}{8mm}}%
    }%
    \foreach \ax/\bx in {0/-6,6/0,12/6,18/12}{%
      \pgfpathmoveto{\pgfpoint{\ax mm}{0mm}}%
      \pgfpathlineto{\pgfpoint{\bx mm}{8mm}}%
    }%
    \pgfusepath{stroke}%
  }

% Yagasuri (arrow feather): pale interlocking fletchings in vertical bands.
% The lightest two-tone fill here, with a brisk upward rhythm; a good ground
% for opening pages and for series that run every month.
\pgfdeclarepatterninherentlycolored{SMyagasuri}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    % The notch at the foot of a feather is the same chevron as the head of
    % the one below, so a column repeats every 4mm without a joint.
    \foreach \cx/\tone in {0/SMpatternA,6/SMpale}{%
      \begin{pgfscope}%
        \pgfsetfillcolor{\tone}%
        \foreach \cy in {-4,0,4}{%
          \begin{pgfscope}%
            \pgftransformshift{\pgfpoint{\cx mm}{\cy mm}}%
            \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
            \pgfpathlineto{\pgfpoint{3mm}{1.5mm}}%
            \pgfpathlineto{\pgfpoint{6mm}{0mm}}%
            \pgfpathlineto{\pgfpoint{6mm}{4mm}}%
            \pgfpathlineto{\pgfpoint{3mm}{5.5mm}}%
            \pgfpathlineto{\pgfpoint{0mm}{4mm}}%
            \pgfpathclose
            \pgfusepath{fill}%
          \end{pgfscope}%
        }%
      \end{pgfscope}%
    }%
    \pgfsetlinewidth{.3pt}%
    \pgfsetstrokecolor{SMband}%
    \foreach \cy in {0,4,8}{%
      \foreach \cx in {0,6}{%
        \begin{pgfscope}%
          \pgftransformshift{\pgfpoint{\cx mm}{\cy mm}}%
          \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
          \pgfpathlineto{\pgfpoint{3mm}{1.5mm}}%
          \pgfpathlineto{\pgfpoint{6mm}{0mm}}%
          \pgfusepath{stroke}%
        \end{pgfscope}%
      }%
    }%
  }

% Tatewaku (rising steam): paired wavy bands that swell and pinch.  A soft
% mid-tone fill, the most organic ground in the set.
\pgfdeclarepatterninherentlycolored{SMtatewaku}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    % Each band is drawn twice, one period apart, because the swell of a band
    % reaches past the tile edge and must be supplied on both sides.
    \foreach \sx in {-12,0}{%
      \begin{pgfscope}%
        \pgftransformshift{\pgfpoint{\sx mm}{0mm}}%
        \pgfsetfillcolor{SMpatternB}%
        \pgfpathmoveto{\pgfpoint{6mm}{0mm}}%
        \pgfpathcurveto{\pgfpoint{4.3mm}{1.3mm}}{\pgfpoint{4.3mm}{2.7mm}}
          {\pgfpoint{6mm}{4mm}}%
        \pgfpathcurveto{\pgfpoint{7.7mm}{5.3mm}}{\pgfpoint{7.7mm}{6.7mm}}
          {\pgfpoint{6mm}{8mm}}%
        \pgfpathlineto{\pgfpoint{12mm}{8mm}}%
        \pgfpathcurveto{\pgfpoint{10.3mm}{6.7mm}}{\pgfpoint{10.3mm}{5.3mm}}
          {\pgfpoint{12mm}{4mm}}%
        \pgfpathcurveto{\pgfpoint{13.7mm}{2.7mm}}{\pgfpoint{13.7mm}{1.3mm}}
          {\pgfpoint{12mm}{0mm}}%
        \pgfpathclose
        \pgfusepath{fill}%
      \end{pgfscope}%
    }%
    \foreach \sx in {0,12}{%
      \begin{pgfscope}%
        \pgftransformshift{\pgfpoint{\sx mm}{0mm}}%
        \pgfsetfillcolor{SMpatternA}%
        \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
        \pgfpathcurveto{\pgfpoint{1.7mm}{1.3mm}}{\pgfpoint{1.7mm}{2.7mm}}
          {\pgfpoint{0mm}{4mm}}%
        \pgfpathcurveto{\pgfpoint{-1.7mm}{5.3mm}}{\pgfpoint{-1.7mm}{6.7mm}}
          {\pgfpoint{0mm}{8mm}}%
        \pgfpathlineto{\pgfpoint{6mm}{8mm}}%
        \pgfpathcurveto{\pgfpoint{7.7mm}{6.7mm}}{\pgfpoint{7.7mm}{5.3mm}}
          {\pgfpoint{6mm}{4mm}}%
        \pgfpathcurveto{\pgfpoint{4.3mm}{2.7mm}}{\pgfpoint{4.3mm}{1.3mm}}
          {\pgfpoint{6mm}{0mm}}%
        \pgfpathclose
        \pgfusepath{fill}%
      \end{pgfscope}%
    }%
  }

% Mitsukuzushi (three-bar break): groups of three rules turning by ninety
% degrees, a woven mat.  Even and quiet, useful for drill and practice pages.
\pgfdeclarepatterninherentlycolored{SMmitsukuzushi}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpale}%
    \pgfpathrectangle{\pgfpoint{0mm}{0mm}}{\pgfpoint{12mm}{8mm}}%
    \pgfusepath{fill}%
    % Two by two blocks of 6mm by 4mm; the bars keep one weight in both
    % directions and only the gaps change, so the weave stays even.
    \pgfsetfillcolor{SMpatternA}%
    \foreach \bx/\by in {0/0,6/4}{%
      \begin{pgfscope}%
        \pgftransformshift{\pgfpoint{\bx mm}{\by mm}}%
        \foreach \r in {0.55,1.7,2.85}{%
          \pgfpathrectangle{\pgfpoint{0mm}{\r mm}}{\pgfpoint{6mm}{.6mm}}%
        }%
        \pgfusepath{fill}%
      \end{pgfscope}%
    }%
    \pgfsetfillcolor{SMpatternB}%
    \foreach \bx/\by in {6/0,0/4}{%
      \begin{pgfscope}%
        \pgftransformshift{\pgfpoint{\bx mm}{\by mm}}%
        \foreach \c in {1.05,2.7,4.35}{%
          \pgfpathrectangle{\pgfpoint{\c mm}{0mm}}{\pgfpoint{.6mm}{4mm}}%
        }%
        \pgfusepath{fill}%
      \end{pgfscope}%
    }%
  }

% Ajiro (plaited bamboo): slanted planks that reverse every row.  The densest
% wagara ground here; reserve it for short titles and cover-style openings.
\pgfdeclarepatterninherentlycolored{SMajiro}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    % Lower course leans right, upper course leans left; each course is paved
    % by translates of one parallelogram, so the rows meet without a gap.
    \foreach \sx/\tone in {-6/SMpatternB,0/SMpatternA,6/SMpatternB,12/SMpatternA}{%
      \begin{pgfscope}%
        \pgfsetfillcolor{\tone}%
        \pgftransformshift{\pgfpoint{\sx mm}{0mm}}%
        \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
        \pgfpathlineto{\pgfpoint{6mm}{0mm}}%
        \pgfpathlineto{\pgfpoint{9mm}{4mm}}%
        \pgfpathlineto{\pgfpoint{3mm}{4mm}}%
        \pgfpathclose
        \pgfusepath{fill}%
      \end{pgfscope}%
    }%
    \foreach \sx/\tone in {-6/SMpatternA,0/SMpatternB,6/SMpatternA,12/SMpatternB}{%
      \begin{pgfscope}%
        \pgfsetfillcolor{\tone}%
        \pgftransformshift{\pgfpoint{\sx mm}{0mm}}%
        \pgfpathmoveto{\pgfpoint{6mm}{4mm}}%
        \pgfpathlineto{\pgfpoint{12mm}{4mm}}%
        \pgfpathlineto{\pgfpoint{9mm}{8mm}}%
        \pgfpathlineto{\pgfpoint{3mm}{8mm}}%
        \pgfpathclose
        \pgfusepath{fill}%
      \end{pgfscope}%
    }%
    \pgfsetlinewidth{.3pt}%
    \pgfsetstrokecolor{SMpale}%
    \foreach \sx in {-6,0,6,12}{%
      \begin{pgfscope}%
        \pgftransformshift{\pgfpoint{\sx mm}{0mm}}%
        \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
        \pgfpathlineto{\pgfpoint{3mm}{4mm}}%
        \pgfpathmoveto{\pgfpoint{6mm}{4mm}}%
        \pgfpathlineto{\pgfpoint{3mm}{8mm}}%
        \pgfusepath{stroke}%
      \end{pgfscope}%
    }%
    \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{0mm}}%
    \pgfpathmoveto{\pgfpoint{0mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{4mm}}%
    \pgfpathmoveto{\pgfpoint{0mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{8mm}}%
    \pgfusepath{stroke}%
  }

% --- Mathematical-motif patterns -----------------------------------------
%
% The nine patterns below evoke mathematics itself rather than ornament.
% They are declared through the key-driven pattern interface so that a
% single declaration serves every tile magnification: the `SM scale'
% pattern key multiplies both the tile and the linework, and the surikumi
% `pattern-scale' key feeds it.  All of them are uncolored patterns, so the
% ink is supplied from outside by `pattern color'; see the pattern-tone
% machinery further down.  Two apparent grey levels are therefore obtained
% from coverage (solid areas against hatched or hairline areas) rather than
% from two fill colours.
\def\smag@ps{\pgfkeysvalueof{/pgf/pattern keys/SM scale}}

% Truchet tiles: quarter arcs meeting at the mid-point of every cell edge,
% with orientations chosen so that the eye reads wandering closed curves.
% A very even, quiet line texture; the safest choice under long titles.
\pgfdeclarepattern{
  name=SMtruchet,
  type=uncolored,
  parameters={\smag@ps},
  x={1mm*\smag@ps}, y={1mm*\smag@ps},
  bottom left={\pgfpointxy{0}{0}},
  top right={\pgfpointxy{16}{12}},
  tile size={\pgfpointxy{16}{12}},
  defaults={SM scale/.initial=1},
  code={%
    \edef\smag@k{\smag@ps}%
    \pgfsetlinewidth{.5pt*\smag@k}%
    \foreach \cx/\cy/\ori in {%
      0/0/0,4/0/1,8/0/1,12/0/0,%
      0/4/1,4/4/1,8/4/0,12/4/1,%
      0/8/0,4/8/0,8/8/1,12/8/1}{%
      \ifnum\ori=0
        \pgfpathmoveto{\pgfpointxy{\cx+2}{\cy}}%
        \pgfpatharc{0}{90}{2mm*\smag@k}%
        \pgfpathmoveto{\pgfpointxy{\cx+4}{\cy+2}}%
        \pgfpatharc{-90}{-180}{2mm*\smag@k}%
      \else
        \pgfpathmoveto{\pgfpointxy{\cx+4}{\cy+2}}%
        \pgfpatharc{90}{180}{2mm*\smag@k}%
        \pgfpathmoveto{\pgfpointxy{\cx+2}{\cy+4}}%
        \pgfpatharc{0}{-90}{2mm*\smag@k}%
      \fi
    }%
    \pgfusepath{stroke}%
  },
}

% Isometric cubes on the rhombille lattice.  One face is solid, one is
% hatched and one is left open, so the block reads three dimensionally even
% though a single ink is available.  The heaviest of the new patterns.
\pgfdeclarepattern{
  name=SMisocubes,
  type=uncolored,
  parameters={\smag@ps},
  x={1mm*\smag@ps}, y={1mm*\smag@ps},
  bottom left={\pgfpointxy{0}{0}},
  top right={\pgfpointxy{12}{8}},
  tile size={\pgfpointxy{12}{8}},
  defaults={SM scale/.initial=1},
  code={%
    \edef\smag@k{\smag@ps}%
    \foreach \hx/\hy in {0/0,12/0,0/8,12/8,6/4}{%
      \pgfpathmoveto{\pgfpointxy{\hx}{\hy}}%
      \pgfpathlineto{\pgfpointxy{\hx-2}{\hy-4}}%
      \pgfpathlineto{\pgfpointxy{\hx+2}{\hy-4}}%
      \pgfpathlineto{\pgfpointxy{\hx+4}{\hy}}%
      \pgfpathclose
    }%
    \pgfusepath{fill}%
    \pgfsetlinewidth{.45pt*\smag@k}%
    \foreach \hx/\hy in {0/0,12/0,0/8,12/8,6/4}{%
      \foreach \s in {0.125,0.375,0.625,0.875}{%
        \pgfpathmoveto{\pgfpointxy{\hx-2*\s}{\hy+4*\s}}%
        \pgfpathlineto{\pgfpointxy{\hx-2*\s-2}{\hy+4*\s-4}}%
      }%
    }%
    \pgfusepath{stroke}%
    \pgfsetlinewidth{.32pt*\smag@k}%
    \foreach \hx/\hy in {0/0,12/0,0/8,12/8,6/4}{%
      \pgfpathmoveto{\pgfpointxy{\hx+4}{\hy}}%
      \pgfpathlineto{\pgfpointxy{\hx+2}{\hy+4}}%
      \pgfpathlineto{\pgfpointxy{\hx-2}{\hy+4}}%
      \pgfpathlineto{\pgfpointxy{\hx-4}{\hy}}%
      \pgfpathlineto{\pgfpointxy{\hx-2}{\hy-4}}%
      \pgfpathlineto{\pgfpointxy{\hx+2}{\hy-4}}%
      \pgfpathclose
      \pgfpathmoveto{\pgfpointxy{\hx}{\hy}}%
      \pgfpathlineto{\pgfpointxy{\hx+4}{\hy}}%
      \pgfpathmoveto{\pgfpointxy{\hx}{\hy}}%
      \pgfpathlineto{\pgfpointxy{\hx-2}{\hy+4}}%
      \pgfpathmoveto{\pgfpointxy{\hx}{\hy}}%
      \pgfpathlineto{\pgfpointxy{\hx-2}{\hy-4}}%
    }%
    \pgfusepath{stroke}%
  },
}

% Sierpinski gaskets to depth three, one gasket per tile, with the parent
% triangle outlined.  Roughly a fifth of the tile is inked, so it stays
% light under a long title while still reading as a recursive figure.
\pgfdeclarepattern{
  name=SMsierpinski,
  type=uncolored,
  parameters={\smag@ps},
  x={1mm*\smag@ps}, y={1mm*\smag@ps},
  bottom left={\pgfpointxy{0}{0}},
  top right={\pgfpointxy{16}{12}},
  tile size={\pgfpointxy{16}{12}},
  defaults={SM scale/.initial=1},
  code={%
    \edef\smag@k{\smag@ps}%
    \foreach \ax/\ay in {0/0,8/0,4/6}{%
      \foreach \bx/\by in {0/0,4/0,2/3}{%
        \foreach \cx/\cy in {0/0,2/0,1/1.5}{%
          \pgfpathmoveto{\pgfpointxy{\ax+\bx+\cx}{\ay+\by+\cy}}%
          \pgfpathlineto{\pgfpointxy{\ax+\bx+\cx+2}{\ay+\by+\cy}}%
          \pgfpathlineto{\pgfpointxy{\ax+\bx+\cx+1}{\ay+\by+\cy+1.5}}%
          \pgfpathclose
        }%
      }%
    }%
    \pgfusepath{fill}%
    \pgfsetlinewidth{.3pt*\smag@k}%
    \pgfpathmoveto{\pgfpointxy{0}{0}}%
    \pgfpathlineto{\pgfpointxy{16}{0}}%
    \pgfpathlineto{\pgfpointxy{8}{12}}%
    \pgfpathclose
    \pgfusepath{stroke}%
  },
}

% Lattice points with one fundamental parallelogram drawn through them.
% The lightest of the new patterns; good under white reversed titles and as
% a background for the slim pattern rule.
\pgfdeclarepattern{
  name=SMlattice,
  type=uncolored,
  parameters={\smag@ps},
  x={1mm*\smag@ps}, y={1mm*\smag@ps},
  bottom left={\pgfpointxy{0}{0}},
  top right={\pgfpointxy{12}{8}},
  tile size={\pgfpointxy{12}{8}},
  defaults={SM scale/.initial=1},
  code={%
    \edef\smag@k{\smag@ps}%
    \pgfsetlinewidth{.4pt*\smag@k}%
    \pgfpathmoveto{\pgfpointxy{0}{0}}%
    \pgfpathlineto{\pgfpointxy{8}{0}}%
    \pgfpathlineto{\pgfpointxy{12}{8}}%
    \pgfpathlineto{\pgfpointxy{4}{8}}%
    \pgfpathclose
    \pgfusepath{stroke}%
    \foreach \dx in {0,4,8,12}{%
      \foreach \dy in {0,4,8}{%
        \pgfpathcircle{\pgfpointxy{\dx}{\dy}}{.62mm*\smag@k}%
      }%
    }%
    \pgfusepath{fill}%
  },
}

% Concentric circle families centred on two interleaved lattices, so the
% circles cut one another and produce a faint moire.  Best at larger
% pattern-scale values, where the interference becomes legible.
\pgfdeclarepattern{
  name=SMmoire,
  type=uncolored,
  parameters={\smag@ps},
  x={1mm*\smag@ps}, y={1mm*\smag@ps},
  bottom left={\pgfpointxy{0}{0}},
  top right={\pgfpointxy{12}{8}},
  tile size={\pgfpointxy{12}{8}},
  defaults={SM scale/.initial=1},
  code={%
    \edef\smag@k{\smag@ps}%
    \pgfsetlinewidth{.35pt*\smag@k}%
    \foreach \rad in {2,4,6}{%
      \foreach \cx/\cy in {0/0,12/0,0/8,12/8}{%
        \pgfpathcircle{\pgfpointxy{\cx}{\cy}}{\rad mm*\smag@k}%
      }%
    }%
    \foreach \rad in {2,4}{%
      \pgfpathcircle{\pgfpointxy{6}{4}}{\rad mm*\smag@k}%
    }%
    \pgfusepath{stroke}%
  },
}

% Curve stitching: one fan of chords per tile, whose envelope is a
% parabola.  Every chord ends on a tile edge, so the tiled plane shows a
% repeated family of parabolic arcs over a light rectangular armature.
\pgfdeclarepattern{
  name=SMenvelopes,
  type=uncolored,
  parameters={\smag@ps},
  x={1mm*\smag@ps}, y={1mm*\smag@ps},
  bottom left={\pgfpointxy{0}{0}},
  top right={\pgfpointxy{12}{8}},
  tile size={\pgfpointxy{12}{8}},
  defaults={SM scale/.initial=1},
  code={%
    \edef\smag@k{\smag@ps}%
    \pgfsetlinewidth{.34pt*\smag@k}%
    \foreach \kk in {0,1,...,10}{%
      \pgfpathmoveto{\pgfpointxy{1.2*\kk}{0}}%
      \pgfpathlineto{\pgfpointxy{0}{0.8*(10-\kk)}}%
    }%
    \pgfusepath{stroke}%
  },
}

% Eight-pointed stars meeting tip to tip on a square lattice, in the
% spirit of girih strapwork; the negative space between four stars forms
% the familiar cross.  An openwork line pattern with a strong grid rhythm.
\pgfdeclarepattern{
  name=SMgirih,
  type=uncolored,
  parameters={\smag@ps},
  x={1mm*\smag@ps}, y={1mm*\smag@ps},
  bottom left={\pgfpointxy{0}{0}},
  top right={\pgfpointxy{12}{8}},
  tile size={\pgfpointxy{12}{8}},
  defaults={SM scale/.initial=1},
  code={%
    \edef\smag@k{\smag@ps}%
    \pgfsetlinewidth{.36pt*\smag@k}%
    \foreach \sx in {0,4,8,12}{%
      \foreach \sy in {0,4,8}{%
        \pgfpathmoveto{\pgfpointxy{\sx+2}{\sy}}%
        \pgfpathlineto{\pgfpointxy{\sx}{\sy+2}}%
        \pgfpathlineto{\pgfpointxy{\sx-2}{\sy}}%
        \pgfpathlineto{\pgfpointxy{\sx}{\sy-2}}%
        \pgfpathclose
        \pgfpathmoveto{\pgfpointxy{\sx+1.414}{\sy+1.414}}%
        \pgfpathlineto{\pgfpointxy{\sx-1.414}{\sy+1.414}}%
        \pgfpathlineto{\pgfpointxy{\sx-1.414}{\sy-1.414}}%
        \pgfpathlineto{\pgfpointxy{\sx+1.414}{\sy-1.414}}%
        \pgfpathclose
      }%
    }%
    \pgfusepath{stroke}%
  },
}

% Circle packing: equal circles in contact along the rows, with a filled
% disc in every curvilinear triangle.  Reads as an open, airy texture and
% contrasts clearly with the solid lenses of SMscales.
\pgfdeclarepattern{
  name=SMpacking,
  type=uncolored,
  parameters={\smag@ps},
  x={1mm*\smag@ps}, y={1mm*\smag@ps},
  bottom left={\pgfpointxy{0}{0}},
  top right={\pgfpointxy{12}{8}},
  tile size={\pgfpointxy{12}{8}},
  defaults={SM scale/.initial=1},
  code={%
    \edef\smag@k{\smag@ps}%
    \pgfsetlinewidth{.4pt*\smag@k}%
    \foreach \cx in {0,4,8,12}{%
      \pgfpathcircle{\pgfpointxy{\cx}{0}}{2mm*\smag@k}%
      \pgfpathcircle{\pgfpointxy{\cx}{8}}{2mm*\smag@k}%
    }%
    \foreach \cx in {2,6,10}{%
      \pgfpathcircle{\pgfpointxy{\cx}{4}}{2mm*\smag@k}%
    }%
    \pgfusepath{stroke}%
    \foreach \cx in {2,6,10}{%
      \pgfpathcircle{\pgfpointxy{\cx}{1.333}}{.34mm*\smag@k}%
      \pgfpathcircle{\pgfpointxy{\cx}{6.667}}{.34mm*\smag@k}%
    }%
    \foreach \cx in {0,4,8,12}{%
      \pgfpathcircle{\pgfpointxy{\cx}{2.667}}{.34mm*\smag@k}%
      \pgfpathcircle{\pgfpointxy{\cx}{5.333}}{.34mm*\smag@k}%
    }%
    \pgfusepath{fill}%
  },
}

% Archimedean spirals, one large at the centre of the tile and four
% quarters meeting at its corners.  The most pictorial of the set; keep it
% for openings whose title is short.
\pgfdeclarepattern{
  name=SMspirals,
  type=uncolored,
  parameters={\smag@ps},
  x={1mm*\smag@ps}, y={1mm*\smag@ps},
  bottom left={\pgfpointxy{0}{0}},
  top right={\pgfpointxy{12}{8}},
  tile size={\pgfpointxy{12}{8}},
  defaults={SM scale/.initial=1},
  code={%
    \edef\smag@k{\smag@ps}%
    \pgfsetlinewidth{.34pt*\smag@k}%
    \foreach \sx/\sy/\sr in {6/4/3.4,0/0/2,12/0/2,0/8/2,12/8/2}{%
      \foreach \t [count=\i] in {0,15,...,900}{%
        \ifnum\i=1
          \pgfpathmoveto{%
            \pgfpointxy{\sx+\sr*\t/900*cos(\t)}{\sy+\sr*\t/900*sin(\t)}}%
        \else
          \pgfpathlineto{%
            \pgfpointxy{\sx+\sr*\t/900*cos(\t)}{\sy+\sr*\t/900*sin(\t)}}%
        \fi
      }%
    }%
    \pgfusepath{stroke}%
  },
}

