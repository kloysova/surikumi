    \renewcommand{\SMAuthorMinchoFont}{\rmfamily\SMAuthorMinchoFontJP}%
  }{}
  \IfFontExistsTF{TeX Gyre Termes}{\setmainfont{TeX Gyre Termes}}{}
  \IfFontExistsTF{TeX Gyre Heros}{\setsansfont{TeX Gyre Heros}}{}
\fi

% A deterministic geometric texture, deliberately generated in TeX so that
% the title bar remains crisp at any output resolution.
\pgfdeclarepatternformonly{SMtriangles}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{7mm}}%
    \pgfpathclose
    \pgfusepath{fill}%
    \pgfpathmoveto{\pgfpoint{6mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{1mm}}%
    \pgfpathclose
    \pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathmoveto{\pgfpoint{6mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{7mm}}%
    \pgfpathclose
    \pgfusepath{fill}%
    \pgfpathmoveto{\pgfpoint{0mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{1mm}}%
    \pgfpathclose
    \pgfusepath{fill}%
  }

% Alternating lozenges: calm and fairly open.
\pgfdeclarepatternformonly{SMdiamonds}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathmoveto{\pgfpoint{0mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{8mm}}%
    \pgfpathclose\pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathmoveto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{8mm}}%
    \pgfpathclose\pgfusepath{fill}%
  }

% Interlocking V forms: stronger direction and movement.
\pgfdeclarepatternformonly{SMchevrons}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{8mm}}%
    \pgfpathclose\pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathmoveto{\pgfpoint{0mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{0mm}}%
    \pgfpathclose\pgfusepath{fill}%
  }

% Soft overlapping lenses, closest to the scale-like texture in the supplied
% printed references.
\pgfdeclarepatternformonly{SMscales}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
    \pgfpathcurveto{\pgfpoint{3mm}{0mm}}
      {\pgfpoint{6mm}{5mm}}{\pgfpoint{6mm}{8mm}}%
    \pgfpathcurveto{\pgfpoint{3mm}{8mm}}
      {\pgfpoint{0mm}{3mm}}{\pgfpoint{0mm}{0mm}}%
    \pgfpathclose\pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathmoveto{\pgfpoint{6mm}{0mm}}%
    \pgfpathcurveto{\pgfpoint{9mm}{0mm}}
      {\pgfpoint{12mm}{5mm}}{\pgfpoint{12mm}{8mm}}%
    \pgfpathcurveto{\pgfpoint{9mm}{8mm}}
      {\pgfpoint{6mm}{3mm}}{\pgfpoint{6mm}{0mm}}%
    \pgfpathclose\pgfusepath{fill}%
  }

% Crossed diagonal strips: a denser woven texture.
\pgfdeclarepatternformonly{SMweave}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{4mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{8mm}{8mm}}%
    \pgfpathclose\pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathmoveto{\pgfpoint{8mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{4mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{0mm}{8mm}}%
    \pgfpathclose\pgfusepath{fill}%
  }

% Honeycomb cells.
\pgfdeclarepatternformonly{SMhexagons}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathmoveto{\pgfpoint{0mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{1.5mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{4.5mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{4.5mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{1.5mm}{8mm}}%
    \pgfpathclose\pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathmoveto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{7.5mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{10.5mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{10.5mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{7.5mm}{8mm}}%
    \pgfpathclose\pgfusepath{fill}%
  }

% Four rotating blades around the centre of each tile.
\pgfdeclarepatternformonly{SMpinwheels}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathmoveto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{0mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{0mm}}%
    \pgfpathclose\pgfusepath{fill}%
    \pgfpathmoveto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{8mm}}%
    \pgfpathclose\pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathmoveto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{4mm}}%
    \pgfpathclose\pgfusepath{fill}%
    \pgfpathmoveto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{0mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{0mm}{4mm}}%
    \pgfpathclose\pgfusepath{fill}%
  }

% Parallel angular waves.
\pgfdeclarepatternformonly{SMzigzags}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathmoveto{\pgfpoint{0mm}{1mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{2mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{1mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{3mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{2mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{2mm}}%
    \pgfpathlineto{\pgfpoint{0mm}{3mm}}%
    \pgfpathclose\pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathmoveto{\pgfpoint{0mm}{5mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{6mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{5mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{7mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{6mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{6mm}}%
    \pgfpathlineto{\pgfpoint{0mm}{7mm}}%
    \pgfpathclose\pgfusepath{fill}%
  }

% Offset rectangular tiles.
\pgfdeclarepatternformonly{SMchecker}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathrectangle{\pgfpoint{0mm}{0mm}}{\pgfpoint{6mm}{4mm}}%
    \pgfusepath{fill}%
    \pgfpathrectangle{\pgfpoint{6mm}{4mm}}{\pgfpoint{6mm}{4mm}}%
    \pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathrectangle{\pgfpoint{6mm}{0mm}}{\pgfpoint{6mm}{4mm}}%
    \pgfusepath{fill}%
    \pgfpathrectangle{\pgfpoint{0mm}{4mm}}{\pgfpoint{6mm}{4mm}}%
    \pgfusepath{fill}%
  }

% Angular parquet linework, based on interlocking wooden strips.
\pgfdeclarepatternformonly{SMparquet}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{16mm}{12mm}}
  {\pgfpoint{16mm}{12mm}}
  {%
    \pgfsetlinewidth{.42pt}%
    \pgfsetstrokecolor{SMrule}%
    \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{8mm}{6mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{0mm}}%
    \pgfpathmoveto{\pgfpoint{0mm}{12mm}}%
    \pgfpathlineto{\pgfpoint{8mm}{6mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{12mm}}%
    \pgfpathmoveto{\pgfpoint{4mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{8mm}{3mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{0mm}}%
    \pgfpathmoveto{\pgfpoint{4mm}{12mm}}%
    \pgfpathlineto{\pgfpoint{8mm}{9mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{12mm}}%
    \pgfpathmoveto{\pgfpoint{0mm}{3mm}}%
    \pgfpathlineto{\pgfpoint{4mm}{6mm}}%
    \pgfpathlineto{\pgfpoint{0mm}{9mm}}%
    \pgfpathmoveto{\pgfpoint{16mm}{3mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{6mm}}%
    \pgfpathlineto{\pgfpoint{16mm}{9mm}}%
    \pgfusepath{stroke}%
  }

% Fine triangular facets: a light origami-like network.
\pgfdeclarepatternformonly{SMorigami}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{16mm}{12mm}}
  {\pgfpoint{16mm}{12mm}}
  {%
