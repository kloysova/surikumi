% Produces one A4 page.  The B5 trim box is 182mm x 257mm and is centred on
% the sheet (14mm side margins and 20mm top/bottom margins).  Artwork extends
% 3mm past the trim on every side; crop marks begin 1mm beyond that bleed.
\NewDocumentCommand{\MakeMathMagazineCover}{}{%
  \clearpage
  \thispagestyle{empty}%
  \smag@covercheckpaper
  \begingroup
  \setlength{\parindent}{0pt}%
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=1mm]
    \coordinate (SMtrimSW) at
      ($(current page.center)+(-91mm,-128.5mm)$);
    \begin{scope}[shift={(SMtrimSW)}]
      % Three-millimetre bleed around the 182mm x 257mm finished cover.
      \begin{scope}
        \clip (-3,-3) rectangle (185,260);
        \fill[white] (-3,-3) rectangle (185,260);

        % Original low-poly colour fields, kept pale behind the cover copy.
        \fill[SMcoverWarm] (116,260)--(185,260)--(185,229)--(146,239)--cycle;
        \fill[SMcoverLime,opacity=.72]
          (185,168)--(116,151)--(185,137)--cycle;
        \fill[SMcoverWarm,opacity=.58]
          (185,137)--(122,116)--(185,102)--cycle;
        \fill[SMcoverBlue!82]
          (-3,-3)--(79,-3)--(93,71)--(41,92)--(-3,76)--cycle;
        \fill[SMcoverViolet,opacity=.88]
          (-3,-3)--(55,-3)--(71,65)--(-3,47)--cycle;
        \fill[SMcoverCyan,opacity=.72]
          (43,-3)--(185,-3)--(185,65)--(105,85)--(73,66)--cycle;
        \fill[SMcoverBlue!28,opacity=.8]
          (-3,39)--(42,93)--(101,75)--(79,-3)--(-3,-3)--cycle;

        \smag@coveranimal

        % Month panel.
        \fill[SMcoverBlue] (158,207) rectangle (178,260);
        \fill[SMcoverDeepBlue] (158,207) rectangle (178,222);
        \fill[SMcoverDeepBlue]
          (178,260)--(185,260)--(185,247)--(178,250)--cycle;
        \node[
          anchor=north,
          text=white,
          inner sep=0pt,
          font=\sffamily\gtfamily\bfseries\fontsize{5.2}{6.2}\selectfont
        ] at (168,255.6) {\smag@coverreleasenote};
        \node[
          text=white,
          inner sep=0pt,
          font=\sffamily\bfseries\fontsize{40}{41}\selectfont
        ] at (168,238) {\smag@covermonth};
        \draw[white,line width=.5pt] (160.5,222.3)--(175.5,222.3);
        \node[
          text=white,
          inner sep=0pt,
          font=\sffamily\fontsize{14}{15}\selectfont
        ] at (168,214.8) {\smag@coveryear};

        % Masthead and publication line.
        \node[
          anchor=north west,
          text=SMink,
          inner sep=0pt,
          font=\sffamily\SMSeriesFont\fontsize{58}{60}\selectfont
        ] at (7,244) {\smag@covermasthead};
        \node[
          anchor=north west,
          text=SMink,
          inner sep=0pt,
          font=\sffamily\fontsize{4.4}{5.3}\selectfont
        ] at (7,253.3) {\smag@coverpublicationnote};

        % Feature label and headline.
        \draw[SMcoverOrange,line width=.45pt] (15,205)--(30,205);
        \draw[SMcoverOrange,line width=.45pt] (45,205)--(60,205);
        \node[
          text=SMcoverOrange,
          inner sep=0pt,
          font=\sffamily\gtfamily\bfseries\fontsize{7.2}{8}\selectfont
        ] at (37.5,205) {\smag@coverfeaturelabel};
        \node[
          anchor=north west,
          text=SMcoverBlue,
          inner sep=0pt,
          font=\sffamily\SMSeriesFont\fontsize{21.5}{25}\selectfont
        ] at (15,198.5) {\smag@coverfeaturetitle};

        \node[anchor=north west,inner sep=0pt,text=SMink]
          at (15,179) {%
            \begin{minipage}{124mm}
              \setlength{\parindent}{0pt}%
              \smag@covermainitems
            \end{minipage}};

        \node[anchor=north west,inner sep=0pt,text=SMink]
          at (15,137) {%
            \begin{minipage}{62mm}
              \setlength{\parindent}{0pt}%
              \smag@coversubitems
            \end{minipage}};

        \node[
          anchor=south east,
          text=white,
          inner sep=0pt,
          font=\sffamily\gtfamily\bfseries\fontsize{8.5}{10}\selectfont
        ] at (176,6) {\begingroup\contourlength{.5pt}%
          \contour{SMink}{\textcolor{white}{\smag@coverpublisher}}\endgroup};
      \end{scope}

      % Crop marks: 1mm clear of the 3mm bleed, then 5mm long.
      \begin{scope}[draw=black,line width=.25pt]
        \draw (0,-9)--(0,-4) (182,-9)--(182,-4);
        \draw (0,261)--(0,266) (182,261)--(182,266);
        \draw (-9,0)--(-4,0) (-9,257)--(-4,257);
        \draw (186,0)--(191,0) (186,257)--(191,257);
      \end{scope}
    \end{scope}
  \end{tikzpicture}%
  \mbox{}\par
  \endgroup
  \clearpage
}

