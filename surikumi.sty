    enhanced,
    breakable,
    colback=white,
    colframe=SMrule,
    boxrule=.55pt,
    sharp corners,
    left=2.5mm,
    right=2.5mm,
    top=2.2mm,
    bottom=2.3mm,
    before skip=.8\baselineskip,
    after skip=.8\baselineskip
  ]%
  \noindent\MMBlackLabel{問題}\hspace{.35em}%
  \MMExerciseNumber{\smag@problem@number}\hspace{.8em}#2\par\smallskip
}{%
  \end{tcolorbox}%
}

