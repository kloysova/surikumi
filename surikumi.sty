% --- Pattern tone, accent, and magnification -----------------------------
%
% The twelve classic patterns and the nine mathematical motifs are uncolored
% pgf patterns, so their ink is supplied from outside by `pattern color'.
% That single hook is what the three keys below drive; SMpatternInk is
% recomputed immediately before each pattern is laid down.  The ten wagara
% patterns are inherently coloured, so pgf ignores `pattern color' for them
% and they keep the grey levels written into their own tiles; only the white
% veil of the current tone reaches them.
%
%   pattern-tone   pale / light / normal / strong
%                  `normal' reproduces the historical appearance exactly:
%                  full-strength ink under a 13 per cent white veil.
%   pattern-accent any colour name, or `none' for the achromatic default.
%                  Ignored by the inherently coloured wagara patterns.
%   pattern-scale  tile magnification, e.g. .8 or 1.4.  It applies to the
%                  mathematical-motif patterns, whose tiles are declared in
%                  terms of the magnification; the twelve classic and the
%                  ten wagara patterns have fixed tiles and ignore it.
\definecolor{SMpatternInk}{gray}{0}
\def\smag@patterntonemix{100}
\def\smag@patternveil{.13}
\def\smag@patternaccent{}
\def\smag@patternscale{1}

\pgfkeys{
  /surikumi,
  pattern-tone/.is choice,
  pattern-tone/pale/.code={%
    \def\smag@patterntonemix{28}\def\smag@patternveil{.42}},
  pattern-tone/light/.code={%
    \def\smag@patterntonemix{55}\def\smag@patternveil{.26}},
  pattern-tone/normal/.code={%
    \def\smag@patterntonemix{100}\def\smag@patternveil{.13}},
  pattern-tone/strong/.code={%
    \def\smag@patterntonemix{100}\def\smag@patternveil{0}},
  pattern-accent/.code={%
    \def\smag@patternaccent{#1}%
    \ifdefstring{\smag@patternaccent}{none}{\def\smag@patternaccent{}}{}%
  },
  pattern-scale/.store in=\smag@patternscale,
}

% Resolve the current tone and accent into the single ink the pattern uses.
\newcommand{\smag@preparepatternink}{%
  \ifdefempty{\smag@patternaccent}{%
    \colorlet{SMpatternInk}{black!\smag@patterntonemix}%
  }{%
    \colorlet{SMpatternInk}{\smag@patternaccent!\smag@patterntonemix!white}%
  }%
}

% Lay the pattern over the rectangle (#1,#2)--(#3,#4) of the surrounding
% picture and cover it with the white veil belonging to the current tone.
% Patterns declared with a tile magnification take the `SM scale' key;
% the classic patterns are filled exactly as before.
\newcommand{\smag@patternfillmeta}[5]{%
  \path[pattern={#1},pattern color=SMpatternInk]
    (#2,#3) rectangle (#4,#5);%
}
\newcommand{\smag@patternfill}[4]{%
  \smag@preparepatternink
  \pgfifpatternundefined{\smag@pattern}{%
    \path[pattern=\smag@pattern,pattern color=SMpatternInk]
      (#1,#2) rectangle (#3,#4);%
  }{%
    \edef\smag@patternspec{\smag@pattern[SM scale=\smag@patternscale]}%
    \expandafter\smag@patternfillmeta\expandafter
      {\smag@patternspec}{#1}{#2}{#3}{#4}%
  }%
  \ifdim\smag@patternveil pt>0pt
    \fill[white,opacity=\smag@patternveil] (#1,#2) rectangle (#3,#4);%
  \fi
}

