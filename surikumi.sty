% =======================================================================
% Readability layer
% =======================================================================
% A 42-character column of 8pt type is unforgiving: a single orphan, one
% unbreakable inline formula, or an align* that cannot cross a column
% boundary is immediately visible.  The parts below address that without
% loosening the page density.

% --- Line- and page-breaking ------------------------------------------
% \raggedbottom is already active, so a column is free to end early.
% Forbidding orphans and widows therefore costs nothing but one line.
\newcommand{\smag@applybreakpenalties}{%
  \clubpenalty=10000
  \widowpenalty=10000
  \displaywidowpenalty=10000
  % Never carry the tail of a hyphenated word into the next column.
  \brokenpenalty=9999
  \doublehyphendemerits=10000
  \finalhyphendemerits=15000
  % The narrow measure needs slightly more freedom than the LaTeX
  % defaults, plus a last-resort reserve instead of an overfull line.
  \tolerance=2500
  \setlength{\emergencystretch}{1.5em}%
  % A long inline formula must be allowed to break; otherwise one
  % relation can push a whole line past the column edge.
  \relpenalty=250
  \binoppenalty=500
  % Let a multi-line display cross a column boundary rather than leave a
  % hole at the foot of the column, but only when nothing better exists.
  \allowdisplaybreaks[1]%
}

% --- Japanese/Latin inter-character spacing ---------------------------
% At 8pt the default gap around Latin words and inline mathematics is too
% small for a formula to stand out from the surrounding Japanese.  A fixed
% natural gap with restrained elasticity keeps the colour of the text even
% while making every formula legible as a separate object.
\newcommand{\smag@kanjiskipvalue}{0pt plus .25\zw minus .02\zw}
\newcommand{\smag@xkanjiskipvalue}{.22\zw plus .1\zw minus .05\zw}
\newcommand{\smag@applyinterspacing}{%
  \ltjsetparameter{%
    kanjiskip={\smag@kanjiskipvalue},
    xkanjiskip={\smag@xkanjiskipvalue}%
  }%
}
% jlreq restores its own values on every font-size change, so the class
% hooks have to learn the new ones as well.
\newcommand{\smag@adoptinterspacing}{%
  \@ifundefined{jlreqkanjiskip}{}{%
    \renewcommand*{\jlreqkanjiskip}{\smag@kanjiskipvalue}%
  }%
  \@ifundefined{jlreqxkanjiskip}{}{%
    \renewcommand*{\jlreqxkanjiskip}{\smag@xkanjiskipvalue}%
  }%
}

\ifsmag@interspacing
  \smag@adoptinterspacing
\fi

% --- Column rule ------------------------------------------------------
% Two things have to be patched into the double-column output routine.
% The kernel draws the rule with \normalcolor, so the colour has to be put
% back; and it draws it with a running height, which makes the rule as tall
% as the text block even on a page whose columns stop half way down --- on
% the last page of an article that leaves a hairline dangling in white
% space.  Unboxing a copy of each column and measuring it again gives the
% height its material really reaches, because the stretchable glue that
% \raggedbottom leaves at the foot contributes nothing to a natural height.
% Under the kernel's \flushbottom, which empties \@textbottom, the columns
% really are stretched to fill and the rule keeps the full height.  A failed
% patch is not an error: the rule then falls back to the kernel's appearance.
% Declared outside the switch below so that TeX can still match \else and
% \fi while it skips the block of a document that did not ask for a rule.
\newif\ifsmag@rulemeasured
\ifsmag@columnrule
  \setlength{\columnseprule}{.25pt}%
  \newbox\smag@rulebox
  \newdimen\smag@rulefull
  \newdimen\smag@ruleink
  \newcommand{\smag@measurecolumn}[1]{%
    \ifvbox#1%
      \setbox\smag@rulebox\vbox{\unvcopy#1}%
      \ifdim\dimexpr\ht\smag@rulebox+\dp\smag@rulebox\relax>\smag@ruleink
        \smag@ruleink\dimexpr\ht\smag@rulebox+\dp\smag@rulebox\relax
      \fi
      \setbox\smag@rulebox\box\voidb@x
    \fi
  }
  \newcommand{\smag@measurecolumnrule}{%
    \smag@rulefull\ht\@leftcolumn
    \ifx\@textbottom\relax
      \smag@ruleink\smag@rulefull
    \else
      \smag@ruleink\z@
      \smag@measurecolumn\@leftcolumn
      \smag@measurecolumn\@outputbox
      \ifdim\smag@ruleink>\smag@rulefull
        \smag@ruleink\smag@rulefull
      \fi
    \fi
  }
  \newcommand{\smag@columnrule}{%
    \ifsmag@rulemeasured
      \raise\dimexpr\smag@rulefull-\smag@ruleink\relax
      \hbox{\color{SMrule}%
        \vrule\@width\columnseprule\@height\smag@ruleink\@depth\z@}%
    \else
      \color{SMrule}\vrule\@width\columnseprule
    \fi
  }
  \patchcmd{\@outputdblcol}
    {\hb@xt@\columnwidth{\box\@leftcolumn \hss}}
    {\smag@measurecolumnrule\hb@xt@\columnwidth{\box\@leftcolumn \hss}}
    {\smag@rulemeasuredtrue}%
    {\PackageWarning{surikumi}%
      {Cannot measure the columns; the rule keeps the full height}}%
  \patchcmd{\@outputdblcol}
    {\normalcolor\vrule \@width\columnseprule}
    {\smag@columnrule}
    {}%
    {\PackageWarning{surikumi}%
      {Cannot draw the column rule; using the kernel's own}}%
  % cuted builds the two columns above a full-width block itself.  There
  % the rule has to reach the block, so only its colour is corrected.
  \ifsmag@strip
    \patchcmd{\@addviper}
      {\normalcolor\vrule \@width\columnseprule}
      {\color{SMrule}\vrule \@width\columnseprule}
      {}{}%
  \fi
\fi

% --- Running head -----------------------------------------------------
% The head follows the article metadata by itself, because it prints the
% macros that \MathMagazineSetup stores.  \MMRunningHead overrides them,
% for instance in an article whose title is too long for the head.
\def\smag@runningheadverso{\smag@series}
\def\smag@runningheadrecto{\smag@title}

\NewDocumentCommand{\MMRunningHead}{o m}{%
  \IfNoValueTF{#1}%
    {\gdef\smag@runningheadverso{#2}}%
    {\gdef\smag@runningheadverso{#1}}%
  \gdef\smag@runningheadrecto{#2}%
}

% No enclosing group: fancyhdr puts the head into a \parbox and ends the
% paragraph after this text, so the 7pt leading has to still be current at
% that moment.  Otherwise the head box claims a full body line.
\newcommand{\smag@runningheadtext}[1]{%
  \normalfont\sffamily\gtfamily
  \fontsize{7}{8.4}\selectfont
  \color{SMrule}#1%
}

% Opening pages keep \thispagestyle{sugakumagazine} and therefore stay
% free of a head, which is where a magazine wants the banner to breathe.
\fancypagestyle{sugakumagazinerunning}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{.3pt}%
  \renewcommand{\footrulewidth}{0pt}%
  \renewcommand{\headrule}{%
    {\color{SMrule}\hrule\@height\headrulewidth\@width\headwidth}%
    \vskip-\headrulewidth}%
  \if@twoside
    \fancyhead[LE]{\smag@runningheadtext{\smag@runningheadverso}}%
    \fancyhead[RO]{\smag@runningheadtext{\smag@runningheadrecto}}%
  \else
    \fancyhead[R]{\smag@runningheadtext{\smag@runningheadrecto}}%
  \fi
  \ifsmag@footer
    \if@twoside
      \fancyfoot[LE,RO]{\sffamily\bfseries\small\thepage}%
    \else
      \fancyfoot[R]{\sffamily\bfseries\small\thepage}%
    \fi
  \fi
}

\ifsmag@runninghead
  \AtBeginDocument{\pagestyle{sugakumagazinerunning}}
\fi

% --- Emphasis ---------------------------------------------------------
% Kenten are the Japanese way of emphasising running text.  They keep the
% body face, the body size and the line pattern intact, which is why they
% are preferred here over bold or a colour.  Squares are reserved for
% confirmation comments, so the mark is a dot.
% The mark itself is renewable, for instance to the sesame dot ﹅.
\newcommand{\MMKentenMark}{\textmd{\textbullet}}

% size and intergap are tuned for 8pt on a 10.8pt baseline: the dot ends
% exactly at the top of the kanji, so it reads as an emphasis mark rather
% than as ruby, and roughly 1.2pt of the interline space is left free
% above it.  A marked line therefore keeps the vertical rhythm; only an
% unusually deep line above it makes TeX open the gap, which is the safe
% direction.
\NewDocumentCommand{\MMKenten}{m}{%
  \ifsmag@ruby
    \ltjkenten[kenten=\MMKentenMark,size=.42,intergap=-.05]{#1}%
  \else
    {\sffamily\gtfamily #1}%
  \fi
}

% First occurrence of a technical term.  Gothic alone is enough contrast
% against Mincho at 8pt, so no extra weight is added.
\NewDocumentCommand{\MMTerm}{m}{{\sffamily\gtfamily #1}}

% Ruby.  Use a vertical bar in both arguments for per-character ruby:
% \MMRuby{漸|化|式}{ぜん|か|しき}
\NewDocumentCommand{\MMRuby}{m m}{%
  \ifsmag@ruby
    \ltjruby{#1}{#2}%
  \else
    #1%
  \fi
}

% --- Section lead -----------------------------------------------------
% A short orientation paragraph under a heading.  It stays in the body
% face and size; only the measure and a hairline set it apart, so it does
% not compete with the heading above it.
\NewDocumentCommand{\MMLead}{+m}{%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    frame hidden,
    colback=white,
    sharp corners,
    boxsep=0pt,
    left=2.6mm,
    right=1.2mm,
    top=.5mm,
    bottom=.5mm,
    borderline west={.4pt}{0pt}{SMrule},
    before skip=.5\baselineskip,
    after skip=.6\baselineskip
  ]%
  \noindent #1%
  \end{tcolorbox}%
}

% --- Formula presentation ---------------------------------------------
% The style guide forbids boxing an answer or a final result.  This box
% presents a formula the reader is meant to keep, which is a different
% job, so it deliberately avoids a closed rectangle: one heavy rule on the
% left and a pale tint, never a frame drawn around a result.
\newtcolorbox{mmformulabox}[1][公式]{%
  enhanced,
  breakable,
  frame hidden,
  colback=SMpale!60!white,
  sharp corners,
  boxsep=0pt,
  left=2.8mm,
  right=2.2mm,
  top=1.5mm,
  bottom=1.6mm,
  borderline west={.9pt}{0pt}{SMink},
  before skip=.7\baselineskip,
  after skip=.7\baselineskip,
  before upper={%
    \ifstrempty{#1}{\noindent}{%
      \noindent\MMBlackLabel{#1}\hspace{.65em}}\ignorespaces}%
}

\NewDocumentCommand{\MMFormulaBox}{O{公式} +m}{%
  \begin{mmformulabox}[#1]#2\end{mmformulabox}%
}

% --- Summary ----------------------------------------------------------
% Rules above and below only.  Together with the label this reads as a
% closing panel and cannot be mistaken for a boxed answer.
\newtcolorbox{mmsummary}[1][まとめ]{%
  enhanced,
  breakable,
  frame hidden,
  colback=white,
  sharp corners,
  boxsep=0pt,
  left=0pt,
  right=0pt,
  top=1.4mm,
  bottom=1.5mm,
  borderline north={.7pt}{0pt}{SMink},
  borderline south={.7pt}{0pt}{SMink},
  before skip=.85\baselineskip,
  after skip=.85\baselineskip,
  before upper={%
    \ifstrempty{#1}{\noindent}{%
      \noindent\MMBlackLabel{#1}\hspace{.65em}}\ignorespaces}%
}

\NewDocumentCommand{\MMSummary}{O{まとめ} +m}{%
  \begin{mmsummary}[#1]#2\end{mmsummary}%
}

% --- Figure and table captions ----------------------------------------
\newcounter{mmfigure}
\newcounter{mmtable}
\newcommand{\MMFigureName}{図}
\newcommand{\MMTableName}{表}
% \ref to a caption prints the kind as well, as 図3 rather than a bare 3.
\def\p@mmfigure{\MMFigureName}
\def\p@mmtable{\MMTableName}

\newcommand{\smag@caption}[2]{%
  \par\addvspace{.32\baselineskip}%
  \begingroup
    \normalfont\rmfamily\mcfamily
    \fontsize{7}{9}\selectfont
    \centering
    \ifstrempty{#1}{}{{\sffamily\gtfamily\bfseries #1}\hspace{.6em}}%
    #2\par
  \endgroup
  \addvspace{.42\baselineskip}%
}

% \MMCaption{...} numbers a figure, \MMCaption[table]{...} a table, and
% the starred form prints an unnumbered caption.
\NewDocumentCommand{\MMCaption}{s O{figure} +m}{%
  \IfBooleanTF{#1}{%
    \smag@caption{}{#3}%
  }{%
    \ifstrequal{#2}{table}{%
      \refstepcounter{mmtable}%
      \smag@caption{\MMTableName\themmtable}{#3}%
    }{%
      \refstepcounter{mmfigure}%
      \smag@caption{\MMFigureName\themmfigure}{#3}%
    }%
  }%
}

% --- Temporarily full-width material ----------------------------------
% Style guide section 8: rather than squeezing an over-long display into
% one column, break it up or let it use the full measure for a moment.
% The leading \par matters: `strip' opens a vbox, so the block has to start
% in vertical mode even when the source has no blank line before it.  The
% gap above and below the strip is \stripsep, which is set from the body
% leading at \begin{document}; the single-column fallback uses the ordinary
% \addvspace instead.
\newif\ifsmag@wideblock@strip
\NewDocumentEnvironment{mmwideblock}{}{%
  \smag@wideblock@stripfalse
  \ifsmag@strip\if@twocolumn\smag@wideblock@striptrue\fi\fi
  \par
  \ifsmag@wideblock@strip
    \begin{strip}%
  \else
    \addvspace{.6\baselineskip}%
  \fi
  \ignorespaces
}{%
  \par
  \ifsmag@wideblock@strip
    \end{strip}%
  \else
    \addvspace{.6\baselineskip}%
  \fi
}

\NewDocumentCommand{\MMWideBlock}{+m}{%
  \begin{mmwideblock}#1\end{mmwideblock}%
}

\AtBeginDocument{%
  \fontsize{\smag@bodyfontsize}{\smag@bodyleading}\selectfont
  \setlength{\parindent}{1em}%
  \setlength{\parskip}{0pt}%
  \smag@applyverticalrhythm
  % cuted's own default is a fixed 15pt, which owes nothing to the body
  % leading.  Tying the gap around a full-width block to the rhythm keeps
  % it looking the same in every density.
  \ifsmag@strip
    \setlength{\stripsep}{1.2\baselineskip plus .4\baselineskip
                          minus .2\baselineskip}%
  \fi
}

% Declared last on purpose: \emergencystretch, the airy rhythm and the
% inter-character spacing are all relative to the body font, which the
% hook above selects.
\AtBeginDocument{%
  \ifsmag@penalties\smag@applybreakpenalties\fi
  \smag@applyairyrhythm
  \ifsmag@interspacing\smag@applyinterspacing\fi
}
\makeatother

