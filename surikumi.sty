% Confirmation symbols use one deterministic drawing system.  TikZ's generic
% pattern fill is anchored to page coordinates, so otherwise identical marks
% can begin their hatching at different phases.  These explicit local strokes
% keep every occurrence identical and give filled/hatched variants one outline.
\def\smag@confirmation@squarepath{%
  (0,0) rectangle (.82,.82)%
}
\def\smag@confirmation@arrowpath{%
  (0,.28) -- (.78,.28) -- (.78,0)
  -- (1.25,.41)
  -- (.78,.82) -- (.78,.54) -- (0,.54) -- cycle%
}

\tikzset{
  smag confirmation outline/.style={
    draw=SMink,
    line width=.38pt,
    line cap=butt,
    line join=miter
  },
  smag confirmation hatch/.style={
    draw=SMink,
    line width=.28pt,
    line cap=butt
  }
}

% Every mark is .82em tall, so one 1.68em-long stroke always crosses the
% whole height; only how many strokes are needed depends on the width.
% The sweep is derived from the mark width and is never allowed to fall
% below the historical range, which keeps the .82em square and the 1.25em
% arrow bit-for-bit identical while wider marks are hatched completely.
\newcommand{\smag@confirmation@hatchlines}[1]{%
  \pgfmathtruncatemacro{\smag@hatchlast}{max(3,ceil((#1-.42)/.28))}%
  \foreach \smag@hatchindex in {-5,...,\smag@hatchlast}{%
    \pgfmathsetmacro{\smag@hatchoffset}{.28*\smag@hatchindex}%
    \draw[smag confirmation hatch]
      (\smag@hatchoffset,-.42) -- ++(1.68,1.68);%
  }%
}

% #1 fill mode, #2 mark width in em, #3 body path, #4 extra outline path.
% The extra outline is stroked but never filled or hatched; it exists so
% that concentric marks share the outline weight of every other symbol.
\newcommand{\smag@confirmation@symbol@core}[4]{%
  \tikz[baseline=.17em,x=1em,y=1em]{%
    \path[use as bounding box] (0,0) rectangle (#2,.82);%
    \ifstrequal{#1}{filled}{%
      \path[fill=SMink] #3;%
    }{%
      \begin{scope}
        \clip #3;%
        \path[fill=white] #3;%
        \smag@confirmation@hatchlines{#2}
      \end{scope}
    }%
    \path[smag confirmation outline] #3;%
    \ifstrempty{#4}{}{\path[smag confirmation outline] #4;}%
  }%
}

\newcommand{\smag@confirmation@symbol}[3]{%
  \smag@confirmation@symbol@core{#1}{#2}{#3}{}%
}

\NewDocumentCommand{\MMConfirmationStripedMark}{}{%
  \smag@confirmation@symbol{hatched}{.82}{\smag@confirmation@squarepath}%
}

\NewDocumentCommand{\MMConfirmationFilledMark}{}{%
  \smag@confirmation@symbol{filled}{.82}{\smag@confirmation@squarepath}%
}

% Arrow-plus-note marks.  They use the same audience distinction as the
% square comment marks: hatched for every reader, solid for motivated readers.
\NewDocumentCommand{\MMConfirmationStripedNoteMark}{}{%
  \smag@confirmation@symbol{hatched}{1.25}{\smag@confirmation@arrowpath}%
  \hspace{.12em}{\normalfont\rmfamily\mcfamily\mdseries 注}%
}

\NewDocumentCommand{\MMConfirmationFilledNoteMark}{}{%
  \smag@confirmation@symbol{filled}{1.25}{\smag@confirmation@arrowpath}%
  \hspace{.12em}{\normalfont\rmfamily\mcfamily\mdseries 注}%
}

\newcommand{\smag@confirmationcomment@begin}[2]{%
  \par\addvspace{.55\baselineskip}
  \noindent #1%
  \ifstrempty{#2}{}{\hspace{.38em}{\bfseries #2}}%
  \hspace{.65em}\ignorespaces
}

\newcommand{\smag@confirmationcomment@end}{%
  \par\addvspace{.28\baselineskip}%
}

% Leave the optional number empty for an isolated comment.  Supply 1, 2, ...
% only while a related local sequence continues; never use a document-wide
% running comment number.
% Hatched square: a comment intended for every reader.
\NewDocumentEnvironment{mmconfirmationgeneralcomment}{O{}}{%
  \smag@confirmationcomment@begin{\MMConfirmationStripedMark}{#1}%
}{%
  \smag@confirmationcomment@end
}

% Solid square: an optional or advanced comment for motivated readers.
\NewDocumentEnvironment{mmconfirmationadvancedcomment}{O{}}{%
  \smag@confirmationcomment@begin{\MMConfirmationFilledMark}{#1}%
}{%
  \smag@confirmationcomment@end
}

