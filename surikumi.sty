% Print a full-width title and enter (or restart) the standard two-column
% output routine. It ends the preceding article itself; do not place a
% redundant \clearpage immediately before this command.
\NewDocumentCommand{\MakeMathMagazineTitle}{}{%
  \ifsmag@twocolumn
    % A fresh \twocolumn[...] works directly at the beginning of a document.
    % For later articles, briefly leave the active two-column output routine;
    % otherwise LaTeX positions the optional full-width box above the top edge.
    \if@twocolumn
      \onecolumn
    \fi
    \twocolumn[\smag@titleblock]%
  \else
    % \twocolumn[...] typesets its optional box without a paragraph indent.
    % The one-column path starts an ordinary paragraph instead, so the
    % full-width title minipage would be pushed out by \parindent.
    \noindent\smag@titleblock
  \fi
  \thispagestyle{sugakumagazine}%
}

