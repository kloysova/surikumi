% Dedicated display faces.  The title uses the heaviest Japanese Gothic
% available, while the author credit uses a sturdy Mincho face.
\newcommand{\SMTitleFont}{\sffamily\gtfamily\bfseries}
\newcommand{\SMSeriesFont}{\sffamily\gtfamily\bfseries}
\newcommand{\SMAuthorMinchoFont}{\rmfamily\mcfamily\bfseries}
\newcommand{\SMAuthorGothicFont}{\sffamily\gtfamily\bfseries}
% Noto ships the same designs under two different names.  The static
% `Noto Serif CJK JP' family carries one file per weight, so a weight is
% asked for by name.  The newer `Noto Serif JP' variable fonts carry every
% weight in a single file and expose no named instances at all, so a weight
% has to be asked for through the wght axis instead; selecting one by name
% there silently fails and the whole family falls back to jlreq's default.
% Both spellings are therefore tried, static first.
\newcommand{\smag@wght}[1]{RawFeature={axis={wght=#1}}}
\ifsmag@fonts
  \IfFontExistsTF{Noto Serif CJK JP}{%
    \setmainjfont[
      BoldFont=Noto Serif CJK JP Bold,
      YokoFeatures={JFM=jlreq}
    ]{Noto Serif CJK JP}%
  }{%
    \IfFontExistsTF{Noto Serif JP}{%
      \setmainjfont[
        BoldFont=Noto Serif JP,
        BoldFeatures={\smag@wght{700}},
        YokoFeatures={JFM=jlreq}
      ]{Noto Serif JP}%
    }{}%
  }
  \IfFontExistsTF{Noto Sans CJK JP}{%
    \setsansjfont[
      BoldFont=Noto Sans CJK JP Bold,
      YokoFeatures={JFM=jlreq}
    ]{Noto Sans CJK JP}%
  }{%
    \IfFontExistsTF{Noto Sans JP}{%
      \setsansjfont[
        BoldFont=Noto Sans JP,
        BoldFeatures={\smag@wght{700}},
        YokoFeatures={JFM=jlreq}
      ]{Noto Sans JP}%
    }{}%
  }
  \IfFontExistsTF{Noto Sans CJK JP Black}{%
    \newjfontfamily\SMTitleFontJP[
      FakeSlant=.12,
      YokoFeatures={JFM=jlreq}
    ]{Noto Sans CJK JP Black}%
    \newjfontfamily\SMSeriesFontJP[
      YokoFeatures={JFM=jlreq}
    ]{Noto Sans CJK JP Black}%
    \renewcommand{\SMTitleFont}{\sffamily\SMTitleFontJP}%
    \renewcommand{\SMSeriesFont}{\sffamily\SMSeriesFontJP}%
  }{%
    \IfFontExistsTF{Noto Sans JP}{%
      \newjfontfamily\SMTitleFontJP[
        \smag@wght{900},
        FakeSlant=.12,
        YokoFeatures={JFM=jlreq}
      ]{Noto Sans JP}%
      \newjfontfamily\SMSeriesFontJP[
        \smag@wght{900},
        YokoFeatures={JFM=jlreq}
      ]{Noto Sans JP}%
      \renewcommand{\SMTitleFont}{\sffamily\SMTitleFontJP}%
      \renewcommand{\SMSeriesFont}{\sffamily\SMSeriesFontJP}%
    }{}%
  }
  \IfFontExistsTF{Noto Serif CJK JP SemiBold}{%
    \newjfontfamily\SMAuthorMinchoFontJP[
      YokoFeatures={JFM=jlreq}
    ]{Noto Serif CJK JP SemiBold}%
    \renewcommand{\SMAuthorMinchoFont}{\rmfamily\SMAuthorMinchoFontJP}%
  }{%
    \IfFontExistsTF{Noto Serif JP}{%
      \newjfontfamily\SMAuthorMinchoFontJP[
        \smag@wght{600},
        YokoFeatures={JFM=jlreq}
      ]{Noto Serif JP}%
      \renewcommand{\SMAuthorMinchoFont}{\rmfamily\SMAuthorMinchoFontJP}%
    }{}%
  }
  \IfFontExistsTF{TeX Gyre Termes}{\setmainfont{TeX Gyre Termes}}{}
  \IfFontExistsTF{TeX Gyre Heros}{\setsansfont{TeX Gyre Heros}}{}
\fi

% A deterministic geometric texture, deliberately generated in TeX so that
% the title bar remains crisp at any output resolution.
\pgfdeclarepatternformonly{SMtriangles}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{7mm}}%
    \pgfpathclose
    \pgfusepath{fill}%
    \pgfpathmoveto{\pgfpoint{6mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{1mm}}%
    \pgfpathclose
    \pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathmoveto{\pgfpoint{6mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{7mm}}%
    \pgfpathclose
    \pgfusepath{fill}%
    \pgfpathmoveto{\pgfpoint{0mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{1mm}}%
    \pgfpathclose
    \pgfusepath{fill}%
  }

% Alternating lozenges: calm and fairly open.
\pgfdeclarepatternformonly{SMdiamonds}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathmoveto{\pgfpoint{0mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{8mm}}%
    \pgfpathclose\pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathmoveto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{8mm}}%
    \pgfpathclose\pgfusepath{fill}%
  }

% Interlocking V forms: stronger direction and movement.
\pgfdeclarepatternformonly{SMchevrons}
  {\pgfpoint{0mm}{0mm}}
  {\pgfpoint{12mm}{8mm}}
  {\pgfpoint{12mm}{8mm}}
  {%
    \pgfsetlinewidth{0pt}%
    \pgfsetfillcolor{SMpatternA}%
    \pgfpathmoveto{\pgfpoint{0mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{0mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{8mm}}%
    \pgfpathclose\pgfusepath{fill}%
    \pgfsetfillcolor{SMpatternB}%
    \pgfpathmoveto{\pgfpoint{0mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{3mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{4mm}}%
    \pgfpathlineto{\pgfpoint{9mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{12mm}{8mm}}%
    \pgfpathlineto{\pgfpoint{6mm}{0mm}}%
