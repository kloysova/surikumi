\renewcommand{\themmconfirmationsubsection}{%
  \arabic{mmconfirmationsection}.\arabic{mmconfirmationsubsection}}

\NewDocumentCommand{\MMConfirmationReset}{}{%
  \setcounter{mmconfirmationsection}{0}%
  \setcounter{mmconfirmationsubsection}{0}%
}

\NewDocumentCommand{\MMConfirmationSection}{s m}{%
