% A deliberately small raised circle, matching the five-minute mark in the
% difficulty legend more closely than the full-width Japanese white circle.
\NewDocumentCommand{\MMFiveMinuteMark}{}{%
  \raisebox{.32ex}{\fontsize{6.2}{6.2}\selectfont °}%
}

\ExplSyntaxOn
\cs_new_protected:Npn \smag_time_marks:n #1
  {
    \int_compare:nNnTF {#1} < {0}
      {\PackageWarning{surikumi}{Target~time~must~be~non-negative}%
       #1\,分}
      {
        \int_compare:nNnTF {\int_mod:nn {#1} {5}} = {0}
          {
            \prg_replicate:nn {\int_div_truncate:nn {#1} {10}} {*}%
            \int_compare:nNnT {\int_mod:nn {#1} {10}} = {5}
              {\MMFiveMinuteMark}%
          }
          {\PackageWarning{surikumi}{Target~time~must~be~a~multiple~of~5}%
           #1\,分}
      }
  }
\NewDocumentCommand{\MMTimeMarks}{m}{\smag_time_marks:n {#1}}
\ExplSyntaxOff

% Difficulty letter plus target-time marks. Ten minutes becomes *, and the
% remaining five minutes becomes °; therefore 25 automatically becomes **°.
\NewDocumentCommand{\MMDifficulty}{m m}{%
  {\normalfont\mcfamily #1\MMTimeMarks{#2}}%
}

\NewDocumentCommand{\MMDifficultyItem}{m m m}{%
  {\bfseries #1}\nobreak\hspace{.12em}$\cdots$\hspace{.12em}%
  \MMDifficulty{#2}{#3}%
}

\NewDocumentCommand{\MMLegend}{O{（記号については☞目次）} m}{%
